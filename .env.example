# Copy to .env and fill in. Never commit .env.
# Gemini API key for the piece explainer (explain/piece): sections 2–3, Gemini 3.8 Flash.
# Without it, sections 2–3 stay empty and the raw text still streams.
GEMINI_API_KEY=
# Claude API key for the session explainer (explain/session): section 4, Claude Opus 5.5.
# Without it, Explain reports it is off and everything else works.
ANTHROPIC_API_KEY=
